  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "e2e:start": "EXPO_PUBLIC_E2E=1 expo start --clear",
    "e2e:web": "EXPO_PUBLIC_E2E=1 expo start --web --clear",
    "e2e:ios": "node scripts/native/build.mjs ios --profile e2e --install",
    "e2e:android": "node scripts/native/build.mjs android --profile e2e --install",
    "e2e:test": "node scripts/e2e/test.mjs",
    "e2e:test:web": "node scripts/e2e/test.mjs --web",
    "web:build": "expo export -p web",
    "native:bundle": "expo export -p ios -p android --output-dir .expo/native-bundles",
    "doctor": "expo-doctor",
    "atlas": "EXPO_ATLAS=true expo start",
    "atlas:export": "EXPO_ATLAS=true expo export",
    "atlas:open": "expo-atlas .expo/atlas.jsonl",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit && tsc -p scripts/brand",
    "test": "jest --silent",
    "test:coverage": "jest --silent --coverage --coverageReporters=json-summary --coverageReporters=text-summary",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "secrets:check": "secretlint \"**/*\"",
    "verify": "yarn format:check && yarn lint && yarn typecheck && yarn secrets:check && yarn test",
    "postinstall": "patch-package && node scripts/brand/index.ts && node scripts/map-worker.mjs",
    "prepare": "husky",
    "storybook:native": "STORYBOOK_ENABLED=true expo start",
    "storybook:ios": "STORYBOOK_ENABLED=true expo start --ios",
    "storybook:android": "STORYBOOK_ENABLED=true expo start --android",
    "storybook:web": "storybook dev -p 6006 -c .storybook",
    "storybook:web:build": "storybook build -c .storybook",
    "brand": "node scripts/brand/index.ts",
    "new": "plop",
    "dev": "expo start --dev-client",
    "eas": "npx --yes eas-cli@18.4.0",
    "env:pull": "node scripts/expo-env.mjs",
    "test:build-config": "node --test scripts/expo-env.test.mjs scripts/ci/build-result.test.mjs .github/actions/summary/summary.test.mjs"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "resolver": "react-native-worklets/jest/resolver.js"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md}": [
      "prettier --write"
    ],
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ],
    "**/*": [
      "secretlint"
    ]
  }
}
