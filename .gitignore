.DS_Store

# JetBrains
/.idea
*.pem

# local env files
.env*
!.env.example

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# auto generated by @storybook/react-native on every metro start
/.rnstorybook/storybook.requires.ts

# Generated by `yarn brand` (also on postinstall) from assets/brand
/assets/brand/generated/
/src/features/theme/palette.json

# web Storybook build (yarn storybook:web:build), deployed by pages.yml
/storybook-static

# husky internals, regenerated by `yarn install` (prepare script)
/.husky/_/

# @generated expo-cli sync-2b81b286409207a5da26e14c78851eb30d8ccbdb
# The following patterns were generated by expo-cli

expo-env.d.ts
# @end expo-cli

# Also written by `yarn brand`: the web app's manifest and icons
/public/manifest.json
/public/icon-web-*.png
/public/maplibre-gl-worker.mjs

# test coverage (yarn test:coverage)
coverage/
.jest-cache/

# e2e: web copies of the Maestro flows (yarn e2e:test:web)
.maestro/.web/

# e2e: Maestro screenshots, logs and report (yarn e2e:test --debug-output e2e-output)
e2e-output/

# native app binaries by fingerprint and build profile (scripts/native)
.native-cache/

# Local EAS submission/signing credentials
/credentials.json
/google-service-account*.json
