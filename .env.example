# Copy to ignored .env and fill in values for the app you are working on.
# This template contains generic examples only.
# EXPO_PUBLIC_ values ship in the app and must not contain secrets.

# -----------------------------------------------------------------------------
# Expo project > Environment variables > selected environment
# Use Sensitive visibility so configuration tools can read these values.
# -----------------------------------------------------------------------------

# App settings are managed in Expo and pulled into ignored .env.local.
# Run: yarn env:pull --environment development
# CI pulls them automatically; no duplicate GitHub variables are needed.
EXPO_PUBLIC_APP_NAME="app"
EXPO_PUBLIC_APP_SLUG="app"
EXPO_PUBLIC_APP_SCHEME="app"
EXPO_PUBLIC_APP_BUNDLE_ID="com.example.app"
EXPO_PUBLIC_API_URL=""
EXPO_PUBLIC_APP_LINK_DOMAINS=""
APP_STORE_CONNECT_ID=""

# -----------------------------------------------------------------------------
# GitHub repository > Settings > Environments > selected environment > Secrets
# Both bootstrap values are GitHub secrets; neither is needed in Expo env config.
# -----------------------------------------------------------------------------

# Existing project UUID. Also set locally in .env.
# The owning account is resolved automatically.
EXPO_PUBLIC_EAS_PROJECT_ID=""
EXPO_TOKEN=""
# EXPO_TOKEN is an Expo access token and stored as a GitHub secret.
# Locally, provide it through your shell when pulling environment settings.
# Do not put a real token in this template.
